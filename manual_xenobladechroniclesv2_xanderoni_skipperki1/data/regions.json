{
    "$schema": "https://github.com/ManualForArchipelago/Manual/raw/main/schemas/Manual.regions.schema.json",
    "Title Screen": {
        "starting": true,
        "connects_to": [
            "Base Game",
            "Future Connected"
        ],
        "exit_requires": {
            "Base Game": "{YamlCompare(GameOrder == 0)} OR {YamlCompare(GameOrder == 1)} OR {YamlCompare(GameOrder == 4)}",
            "Future Connected": "{YamlCompare(GameOrder == 2)} OR {YamlCompare(GameOrder == 3)} OR {YamlCompare(GameOrder == 4)}"
        }
    },
    "Base Game": {
        "connects_to": [
            "Colony 9",
            "Post Game"
        ],
        "exit_requires": {
            "Post Game": "{YamlEnabled(Post_Game)}"
        }
    },
    "Colony 9":                         { "connects_to": [ "Tephra Cave" ],                   "requires": "|Colony 9 Key:all|"                                              },
    "Tephra Cave":                      { "connects_to": [ "Bionis' Leg" ],                   "requires": "|Tephra Cave Key:all|"                                           },
    "Bionis' Leg":                      { "connects_to": [ "Colony 6" ],                      "requires": "|Bionis' Leg Key:all|"                                           },
    "Colony 6":                         { "connects_to": [ "Ether Mine" ],                    "requires": "|Colony 6 Key:all|"                                              },
    "Ether Mine":                       { "connects_to": [ "Satorl Marsh" ],                  "requires": "|Ether Mine Key:all|"                                            },
    "Satorl Marsh":                     { "connects_to": [ "Bionis' Interior (1st Visit)" ],  "requires": "|Satorl Marsh Key:all|"                                          },
    "Bionis' Interior (1st Visit)":     { "connects_to": [ "Makna Forest" ],                  "requires": "|Bionis' Interior (1st Visit) Key:all|"                          },
    "Makna Forest":                     { "connects_to": [ "Frontier Village" ],              "requires": "|Makna Forest Key:all|"                                          },
    "Frontier Village":                 { "connects_to": [ "Eryth Sea" ],                     "requires": "|Frontier Village Key:all|"                                      },
    "Eryth Sea":                        { "connects_to": [ "Alcamoth" ],                      "requires": "|Eryth Sea Key:all|"                                             },
    "Alcamoth":                         { "connects_to": [ "High Entia Tomb" ],               "requires": "|Alcamoth Key:all|"                                              },
    "High Entia Tomb":                  { "connects_to": [ "Prison Island (1st Visit)" ],     "requires": "|High Entia Tomb Key:all|"                                       },
    "Prison Island (1st Visit)":        { "connects_to": [ "Valak Mountain" ],                "requires": "|Prison Island (1st Visit) Key:all|"                             },
    "Valak Mountain":                   { "connects_to": [ "Sword Valley (MISSABLE)" ],       "requires": "|Valak Mountain Key:all|"                                        },
    "Sword Valley (MISSABLE)":          { "connects_to": [ "Galahad Fortress (MISSABLE)" ],   "requires": "|Sword Valley Key:all| AND {OptOne(|Progressive Hunting License:10|)}"     },
    "Galahad Fortress (MISSABLE)":      { "connects_to": [ "Fallen Arm" ],                    "requires": "|Galahad Fortress Key:all|"                                      },
    "Fallen Arm":                       { "connects_to": [ "Mechonis Field (MISSABLE)" ],     "requires": "|Fallen Arm Key:all|"                                            },
    "Mechonis Field (MISSABLE)":        { "connects_to": [ "Central Factory (MISSABLE)" ],    "requires": "|Mechonis Field Key:all|"                                        },
    "Central Factory (MISSABLE)":       { "connects_to": [ "Agniratha (MISSABLE)" ],          "requires": "|Central Factory Key:all|"                                       },
    "Agniratha (MISSABLE)":             { "connects_to": [ "Mechonis Core" ],                 "requires": "|Agniratha Key:all|"                                             },
    "Mechonis Core":                    { "connects_to": [ "Bionis' Interior (2nd Visit)" ],  "requires": "|Mechonis Core Key:all| AND {OptOne(|Progressive Hunting License:16|)}" },
    "Bionis' Interior (2nd Visit)":     { "connects_to": [ "Prison Island (2nd Visit)" ],     "requires": "|Bionis' Interior (2nd Visit) Key:all|"                          },
    "Prison Island (2nd Visit)":        { "connects_to": [ "Memory Space" ],                  "requires": "|Prison Island (2nd Visit) Key:all|"                             },
    "Memory Space":                     { "connects_to": [ "Post Game", "Future Connected" ], "requires": "|Memory Fragment:all|"                                           },
    "Post Game": {
        "connects_to": [
            "Colony 9",                     "Tephra Cave",                  "Bionis' Leg",                  "Colony 6",
            "Ether Mine",                   "Satorl Marsh",                 "Bionis' Interior (1st Visit)", "Makna Forest",
            "Frontier Village",             "Eryth Sea",                    "Alcamoth",                     "High Entia Tomb",
            "Prison Island (1st Visit)",    "Valak Mountain",               "Sword Valley (MISSABLE)",      "Galahad Fortress (MISSABLE)",
            "Fallen Arm",                   "Mechonis Field (MISSABLE)",    "Central Factory (MISSABLE)",   "Agniratha (MISSABLE)",
            "Mechonis Core",                "Bionis' Interior (2nd Visit)", "Prison Island (2nd Visit)",    "Memory Space"
        ]
    },
    "Future Connected": {
        "connects_to": [
            "Future Connected Part I",
            "FC Post Game"
        ],
        "exit_requires": {
            "FC Post Game": "{YamlEnabled(FC_Post_Game)}"
        }
    },
    "Future Connected Part I":          { "connects_to": [ "Future Connected Part II" ],      "requires": "|Bionis' Shoulder Key:all|"                                      },
    "Future Connected Part II":         { "connects_to": [ "Future Connected Part III" ],     "requires": "|Melfica Road Key:all|"                                          },
    "Future Connected Part III":        { "connects_to": [ "Future Connected Part IV" ],      "requires": "|Gran Dell Key:all|"                                             },
    "Future Connected Part IV":         { "connects_to": [ "Future Connected Finale" ],       "requires": "|Monado EX+ Plans:all|"                                                },
    "Future Connected Finale":          { "connects_to": [ "FC Post Game", "Base Game" ],     "requires": "|Palace Teleporter Key:all|"                                     },
    "FC Post Game": {
        "connects_to": [
            "Future Connected Part I",      "Future Connected Part II",     "Future Connected Part III",    "Future Connected Part IV",
            "Future Connected Finale"
        ]
    }
}